{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lakehouse-customer-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "dispatch_namespaces": [
    {
      "binding": "USER_WORKERS",
      "namespace": "lakehouse-customer-workers"
    }
  ]
}
