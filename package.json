{
  "name": "lakehouse-architect",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "workers/*"
  ],
  "scripts": {
    "dev": "next dev",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:shard": "tsx scripts/shard-and-index.ts",
    "r2:sync:local": "tsx scripts/seed-local-r2.ts",
    "build:next": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "build": "npm run content:validate && npm run content:shard && npm run build:worker",
    "build:cf": "npm run build",
    "package": "npm run build",
    "r2:sync:remote": "tsx scripts/sync-r2-artifacts.ts",
    "r2:sync:remote:force": "tsx scripts/sync-r2-artifacts.ts --force",
    "deploy:cf": "npm run build && npm run r2:sync:remote && opennextjs-cloudflare deploy --cacheChunkSize 10",
    "deploy:quick": "npm run build:worker && opennextjs-cloudflare deploy --cacheChunkSize 10",
    "deploy:code": "npm run build:worker && opennextjs-cloudflare deploy --cacheChunkSize 10",
    "dev:customer-dispatcher": "wrangler dev --config workers/customer-dispatcher/wrangler.jsonc",
    "deploy:customer-dispatcher": "wrangler deploy --config workers/customer-dispatcher/wrangler.jsonc",
    "deploy:dispatcher": "npm run --workspace=@lakehouse/customer-dispatcher deploy",
    "deploy:all": "npm run deploy:cf && npm run deploy:customer-dispatcher",
    "preview": "npm run build && npm run r2:sync:local && opennextjs-cloudflare preview",
    "deploy": "npm run deploy:cf",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "cross-env ANALYZE=true next build --webpack"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.20",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/prismjs": "^1.26.6",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.37.0",
    "minisearch": "^7.2.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "wrangler": "^4.152.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "glob": "^11.0.0",
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
